pragma solidity ^0.8.24;
contract Lottery { address public manager; address[] public players; uint256 public entryFee; uint256 public nonce; event Entered(address indexed player); event Winner(address indexed winner,uint256 amount); constructor(uint256 fee){manager=msg.sender;entryFee=fee;} function enter() external payable {require(msg.value==entryFee,"Wrong fee");players.push(msg.sender);emit Entered(msg.sender);} function pickWinner() external {require(msg.sender==manager,"Manager only");require(players.length>0,"No players");uint256 idx=uint256(keccak256(abi.encodePacked(block.prevrandao,block.timestamp,players.length,nonce++)))%players.length;address winner=players[idx];uint256 pot=address(this).balance;delete players;(bool ok,)=winner.call{value:pot}("");require(ok,"Transfer failed");emit Winner(winner,pot);}}