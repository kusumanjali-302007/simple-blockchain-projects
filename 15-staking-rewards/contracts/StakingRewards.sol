pragma solidity ^0.8.24;
contract StakingRewards { mapping(address=>uint256) public staked; mapping(address=>uint256) public rewardDebt; uint256 public totalStaked; uint256 public rewardRate; uint256 public lastUpdate; constructor(uint256 rate){rewardRate=rate;lastUpdate=block.timestamp;} function _accrue(address u) internal {uint256 elapsed=block.timestamp-lastUpdate;if(totalStaked>0){rewardDebt[u]+=staked[u]*rewardRate*elapsed/1e18;}lastUpdate=block.timestamp;} function stake() external payable {require(msg.value>0,"Zero");_accrue(msg.sender);staked[msg.sender]+=msg.value;totalStaked+=msg.value;} function withdraw(uint256 amount) external {require(staked[msg.sender]>=amount,"Balance");_accrue(msg.sender);staked[msg.sender]-=amount;totalStaked-=amount;(bool ok,)=msg.sender.call{value:amount}("");require(ok,"Transfer failed");} function claim() external { _accrue(msg.sender); uint256 r=rewardDebt[msg.sender]; require(r>0,"No rewards"); rewardDebt[msg.sender]=0; (bool ok,)=msg.sender.call{value:r}(""); require(ok,"Reward failed"); }}