pragma solidity ^0.8.24;
contract SimpleWallet { mapping(address=>uint256) public balances; event Deposit(address indexed user,uint256 amount); event Withdrawal(address indexed user,uint256 amount); function deposit() external payable {require(msg.value>0,"Zero deposit");balances[msg.sender]+=msg.value;emit Deposit(msg.sender,msg.value);} function withdraw(uint256 amount) external {require(balances[msg.sender]>=amount,"Insufficient balance");balances[msg.sender]-=amount;(bool ok,)=msg.sender.call{value:amount}("");require(ok,"Transfer failed");emit Withdrawal(msg.sender,amount);} receive() external payable {balances[msg.sender]+=msg.value;emit Deposit(msg.sender,msg.value);}}