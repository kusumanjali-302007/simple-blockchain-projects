pragma solidity ^0.8.24;
contract PortfolioNFT { string public name="Portfolio NFT"; string public symbol="PNFT"; uint256 public nextTokenId=1; mapping(uint256=>address) public ownerOf; mapping(address=>uint256) public balanceOf; mapping(uint256=>string) public tokenURI; event Transfer(address indexed from,address indexed to,uint256 indexed tokenId); function mint(string calldata uri) external returns(uint256 id){id=nextTokenId++;ownerOf[id]=msg.sender;balanceOf[msg.sender]++;tokenURI[id]=uri;emit Transfer(address(0),msg.sender,id);} function transferFrom(address from,address to,uint256 id) external {require(ownerOf[id]==from,"Not owner");require(msg.sender==from,"Not approved");require(to!=address(0),"Zero");ownerOf[id]=to;balanceOf[from]--;balanceOf[to]++;emit Transfer(from,to,id);}}