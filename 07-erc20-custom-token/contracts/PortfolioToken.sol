pragma solidity ^0.8.24;
contract PortfolioToken { string public constant name="Portfolio Token"; string public constant symbol="PTK"; uint8 public constant decimals=18; uint256 public totalSupply; mapping(address=>uint256) public balanceOf; mapping(address=>mapping(address=>uint256)) public allowance; event Transfer(address indexed from,address indexed to,uint256 value); event Approval(address indexed owner,address indexed spender,uint256 value); constructor(uint256 initialSupply){_mint(msg.sender,initialSupply*10**18);} function transfer(address to,uint256 value) external returns(bool){_transfer(msg.sender,to,value);return true;} function approve(address s,uint256 v) external returns(bool){allowance[msg.sender][s]=v;emit Approval(msg.sender,s,v);return true;} function transferFrom(address f,address t,uint256 v) external returns(bool){require(allowance[f][msg.sender]>=v,"Allowance");allowance[f][msg.sender]-=v;_transfer(f,t,v);return true;} function mint(uint256 amount) external {_mint(msg.sender,amount*10**18);} function burn(uint256 amount) external {uint256 v=amount*10**18;require(balanceOf[msg.sender]>=v,"Balance");balanceOf[msg.sender]-=v;totalSupply-=v;emit Transfer(msg.sender,address(0),v);} function _mint(address to,uint256 v) internal{balanceOf[to]+=v;totalSupply+=v;emit Transfer(address(0),to,v);} function _transfer(address f,address t,uint256 v) internal{require(t!=address(0),"Zero");require(balanceOf[f]>=v,"Balance");balanceOf[f]-=v;balanceOf[t]+=v;emit Transfer(f,t,v);}}