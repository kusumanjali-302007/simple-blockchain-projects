pragma solidity ^0.8.24;
contract MultiSigWallet { address[] public owners; mapping(address=>bool) public isOwner; uint256 public immutable required; struct Tx{address to;uint256 value;bytes data;bool executed;uint256 confirmations;} Tx[] public transactions; mapping(uint256=>mapping(address=>bool)) public confirmed; modifier ownerOnly(){require(isOwner[msg.sender],"Owner only");_;} constructor(address[] memory _owners,uint256 _required){require(_owners.length>0&&_required>0&&_required<=_owners.length,"Invalid");for(uint i=0;i<_owners.length;i++){require(_owners[i]!=address(0)&&!isOwner[_owners[i]],"Invalid owner");isOwner[_owners[i]]=true;owners.push(_owners[i]);}required=_required;} receive() external payable{} function submit(address to,uint256 value,bytes calldata data) external ownerOnly returns(uint256){transactions.push(Tx(to,value,data,false,0));return transactions.length-1;} function confirm(uint256 id) external ownerOnly {Tx storage t=transactions[id];require(!t.executed&&!confirmed[id][msg.sender],"Invalid");confirmed[id][msg.sender]=true;t.confirmations++;} function execute(uint256 id) external ownerOnly {Tx storage t=transactions[id];require(!t.executed&&t.confirmations>=required,"Not enough confirmations");t.executed=true;(bool ok,)=t.to.call{value:t.value}(t.data);require(ok,"Call failed");}}